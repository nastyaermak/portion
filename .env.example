# Скопіюйте цей файл у .env і впишіть свої значення.
# Справжній .env не комітиться (він у .gitignore).

# Секретний ключ Django. Згенерувати новий:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# True — для локальної розробки, False — на сервері
DEBUG=True

# Через кому, без пробілів
ALLOWED_HOSTS=127.0.0.1,localhost

# Адреси фронтенду, яким дозволено звертатися до API (через кому)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Файл бази SQLite (відносно кореня проєкту)
DB_NAME=db.sqlite3

# Рівень логів для коду проєкту: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
